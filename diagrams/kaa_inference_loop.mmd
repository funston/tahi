%%{init: {'theme': 'base', 'themeVariables': { 'fontFamily': 'Inter, system-ui, sans-serif', 'fontSize': '15px', 'primaryColor': '#0d9488', 'primaryTextColor': '#ffffff', 'primaryBorderColor': '#115e59', 'lineColor': '#64748b', 'secondaryColor': '#f0fdfa', 'tertiaryColor': '#fff7ed' }}}%%
flowchart TB
    subgraph Input["Input"]
        H["Hidden State / Query Embedding"]
    end

    subgraph Knowledge["🗺️ Knowledge Retrieval"]
        direction TB
        I["Index Search"]
        G["Retrieved Graph Neighborhood"]
        K["Graph Keys / Values"]
    end

    subgraph Action["⚡ Action / Fusion"]
        direction TB
        T["Token Keys / Values"]
        M["Attention Mixer"]
        C["Updated Cognitive Signal"]
    end

    subgraph Answer["Answer"]
        N["Next Decode Step"]
    end

    H --> I
    I --> G
    G --> K
    T --> M
    K --> M
    M --> C
    C --> N
    N -.->|feedback| H

    classDef input fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#312e81,font-size:14px
    classDef knowledge fill:#f0fdfa,stroke:#0d9488,stroke-width:2px,color:#134e4a,font-size:14px
    classDef action fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#7c2d12,font-size:14px
    classDef answer fill:#f0fdf4,stroke:#22c55e,stroke-width:3px,color:#14532d,font-size:15px

    class H input
    class I,G,K knowledge
    class T,M,C action
    class N answer
